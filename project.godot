; Engine configuration file.
; Prefer editing this file through Godot for generated settings.
config_version=5

[application]

config/name="Xiuxian Game"
config/description="Single-player Godot MVP foundation for a xiuxian reincarnation sandbox."
run/main_scene="res://scenes/debug_boot.tscn"
config/features=PackedStringArray("4.6")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
